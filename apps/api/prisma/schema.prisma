generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ------------------------------------------------------------
// 1. Papéis de acesso
// ------------------------------------------------------------
model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // 'ORGANIZER' | 'CLIENT' | 'GATE'

  users User[]

  @@map("roles")
}

// ------------------------------------------------------------
// 2. Usuários
// ------------------------------------------------------------
model User {
  id                String   @id @default(uuid())
  roleId            Int      @map("role_id")
  name              String
  email             String   @unique
  passwordHash      String   @map("password_hash")
  cpf               String   @unique
  phone             String?
  birthDate         String?  @map("birth_date") // YYYY-MM-DD
  profilePictureUrl String?  @map("profile_picture_url")
  createdAt         DateTime @default(now()) @map("created_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Relações inversas
  organizedEvents      Event[]           @relation("EventOrganizer")
  gatekeeperAssignments EventGatekeeper[]
  reservedSeats         EventSeat[]       @relation("ReservedBy")
  purchasedTickets       Ticket[]          @relation("TicketBuyer")
  validatedTickets       Ticket[]          @relation("TicketValidator")

  @@index([roleId])
  @@map("users")
}

// ------------------------------------------------------------
// 3. Locais / Salas
// ------------------------------------------------------------
model Venue {
  id               String @id @default(uuid())
  name             String
  address          String
  hasAssignedSeats Boolean @default(false) @map("has_assigned_seats")
  totalCapacity    Int     @map("total_capacity")

  seats  Seat[]
  events Event[]

  @@map("venues")
}

// ------------------------------------------------------------
// 4. Assentos físicos do local
// ------------------------------------------------------------
model Seat {
  id         String @id @default(uuid())
  venueId    String @map("venue_id")
  rowLabel   String @map("row_label")     // ex: '16' ou 'D'
  seatNumber Int    @map("seat_number")
  gridX      Int    @map("grid_x")
  gridY      Int    @map("grid_y")
  seatType   String @default("STANDARD") @map("seat_type")
  // 'STANDARD' | 'WHEELCHAIR' | 'COMPANION' | 'OBESE' | 'REDUCED_MOBILITY'

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  eventSeats EventSeat[]
  tickets    Ticket[]

  @@unique([venueId, rowLabel, seatNumber])
  @@index([venueId])
  @@map("seats")
}

// ------------------------------------------------------------
// 5. Eventos
// ------------------------------------------------------------
model Event {
  id                String   @id @default(uuid())
  organizerId       String   @map("organizer_id")
  venueId           String   @map("venue_id")
  title             String
  description       String?
  bannerUrl         String?  @map("banner_url")
  eventType         String   @map("event_type")
  // 'SHOW' | 'MOVIE' | 'THEATER' | 'FESTIVAL' | 'OTHER'
  startTime         DateTime @map("start_time")
  externalApiSource String?  @map("external_api_source") // 'TMDB' | 'TICKETMASTER'
  externalApiId     String?  @map("external_api_id")
  status            String   @default("PUBLISHED")
  // 'DRAFT' | 'PUBLISHED' | 'CANCELLED'
  createdAt         DateTime @default(now()) @map("created_at")

  organizer User  @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  venue     Venue @relation(fields: [venueId], references: [id], onDelete: Restrict)

  eventSeats    EventSeat[]
  gatekeepers   EventGatekeeper[]
  ticketTypes   TicketType[]
  tickets       Ticket[]

  @@index([organizerId])
  @@map("events")
}

// ------------------------------------------------------------
// 6. Estado do assento por evento
// ------------------------------------------------------------
model EventSeat {
  id                     String    @id @default(uuid())
  eventId                String    @map("event_id")
  seatId                 String    @map("seat_id")
  status                 String    @default("AVAILABLE")
  // 'AVAILABLE' | 'RESERVED' | 'SOLD' | 'BLOCKED'
  reservedById           String?   @map("reserved_by_id")
  reservationExpiresAt   DateTime? @map("reservation_expires_at")

  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seat       Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)
  reservedBy User?  @relation("ReservedBy", fields: [reservedById], references: [id], onDelete: SetNull)

  @@unique([eventId, seatId])
  @@index([eventId, status])
  @@map("event_seats")
}

// ------------------------------------------------------------
// 7. Vínculo de porteiros ao evento
// ------------------------------------------------------------
model EventGatekeeper {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  gatekeeperId String   @map("gatekeeper_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gatekeeper User  @relation(fields: [gatekeeperId], references: [id], onDelete: Cascade)

  @@unique([eventId, gatekeeperId])
  @@map("event_gatekeepers")
}

// ------------------------------------------------------------
// 8. Tipos de ingresso
// ------------------------------------------------------------
model TicketType {
  id                 String @id @default(uuid())
  eventId            String @map("event_id")
  name               String // ex: 'Meia-Entrada', 'Inteira'
  price              Float
  description        String?
  quantityAvailable  Int    @map("quantity_available")

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@map("ticket_types")
}

// ------------------------------------------------------------
// 9. Ingressos comprados e emitidos
// ------------------------------------------------------------
model Ticket {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  ticketTypeId  String    @map("ticket_type_id")
  buyerId       String    @map("buyer_id")
  seatId        String?   @map("seat_id") // null em evento de pista sem assento
  buyerName     String    @map("buyer_name")
  accessCode    String    @unique @map("access_code")     // código manual da portaria
  qrCodeToken   String    @unique @map("qr_code_token")   // hash assinado (HMAC) do QR
  shareToken    String    @unique @map("share_token")     // token da URL de compartilhamento
  status        String    @default("VALID")
  // 'VALID' | 'USED' | 'EXPIRED' | 'CANCELLED'
  validatedAt   DateTime? @map("validated_at")
  validatedById String?   @map("validated_by_id")
  purchasedAt   DateTime  @default(now()) @map("purchased_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  buyer      User       @relation("TicketBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seat       Seat?      @relation(fields: [seatId], references: [id], onDelete: Restrict)
  validatedBy User?     @relation("TicketValidator", fields: [validatedById], references: [id], onDelete: SetNull)

  // Segunda camada de segurança: mesmo assento não pode ser vendido 2x no mesmo evento
  @@unique([eventId, seatId])
  @@index([buyerId])
  @@index([eventId])
  @@index([accessCode])
  @@index([qrCodeToken])
  @@index([shareToken])
  @@map("tickets")
}
